#include <windows.h>
#include "resource.h"

IDD_CONNECT_DLG DIALOG DISCARDABLE  32, 32, 180, 110
STYLE DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Connect to VNC Server"
FONT 8, "MS Sans Serif"
BEGIN
    LTEXT           "&Server IP:", IDC_STATIC, 10, 10, 40, 10, SS_RIGHT
    EDITTEXT        IDC_IP_EDIT, 55, 8, 115, 12, ES_AUTOHSCROLL

    LTEXT           "&Port:", IDC_STATIC, 10, 28, 40, 10, SS_RIGHT
    EDITTEXT        IDC_PORT_EDIT, 55, 26, 45, 12, ES_NUMBER | ES_AUTOHSCROLL

    LTEXT           "Pass&word:", IDC_STATIC, 10, 47, 40, 10, SS_RIGHT
    EDITTEXT        IDC_PASS_EDIT, 55, 44, 115, 12, ES_PASSWORD | ES_AUTOHSCROLL

    CHECKBOX        "&Use Fast Encoding", IDC_FASTENC_CHK, 55, 60, 80, 14, BS_AUTOCHECKBOX

    DEFPUSHBUTTON   "&OK", IDOK, 35, 85, 50, 14
    PUSHBUTTON      "&Cancel", IDCANCEL, 95, 85, 50, 14
END
